generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  ERROR
}

enum CycleStatus {
  IDLE
  PREPARING
  DRYING
  PAUSED
  COMPLETED
  CANCELLED
  ERROR
}

enum AlertType {
  HIGH_TEMPERATURE
  LOW_TEMPERATURE
  HIGH_HUMIDITY
  DOOR_OPEN
  OVERCURRENT
  OVERWEIGHT
  SENSOR_FAILURE
  COMMUNICATION_FAILURE
  ABNORMAL_ENERGY
  DRYING_COMPLETE
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

model Device {
  id           String          @id @default(cuid())
  name         String
  serialNumber String          @unique
  apiKeyHash   String
  status       DeviceStatus    @default(OFFLINE)
  lastSeen     DateTime?
  maxLoadKg    Float?
  maxCurrent   Float?
  telemetry    Telemetry[]
  cycles       DryingCycle[]
  alerts       Alert[]
  commands     DeviceCommand[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Telemetry {
  id                String       @id @default(cuid())
  deviceId          String
  cycleId           String?
  temperature       Float
  humidity          Float
  weight            Float
  doorOpen          Boolean
  motorOn           Boolean
  heaterOn          Boolean
  fanOn             Boolean
  current           Float
  voltage           Float
  energyConsumption Float
  timestamp         DateTime
  createdAt         DateTime     @default(now())
  device            Device       @relation(fields: [deviceId], references: [id])
  cycle             DryingCycle? @relation(fields: [cycleId], references: [id])

  @@index([deviceId, timestamp])
}

model DryingCycle {
  id                  String      @id @default(cuid())
  deviceId            String
  status              CycleStatus @default(PREPARING)
  startTime           DateTime    @default(now())
  endTime             DateTime?
  initialWeight       Float
  finalWeight         Float?
  targetHumidity      Float
  maximumTemperature  Float       @default(0)
  energyConsumed      Float       @default(0)
  lowHumidityReadings Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  device              Device      @relation(fields: [deviceId], references: [id])
  telemetry           Telemetry[]
  alerts              Alert[]
}

model Alert {
  id           String       @id @default(cuid())
  deviceId     String
  cycleId      String?
  type         AlertType
  severity     Severity
  message      String
  value        Float?
  acknowledged Boolean      @default(false)
  createdAt    DateTime     @default(now())
  device       Device       @relation(fields: [deviceId], references: [id])
  cycle        DryingCycle? @relation(fields: [cycleId], references: [id])

  @@index([deviceId, acknowledged])
}

model DeviceCommand {
  id            String   @id @default(cuid())
  deviceId      String
  cycleId       String?
  heater        String
  motor         String
  fan           String
  safe          Boolean
  emergencyStop Boolean
  reason        String?
  createdAt     DateTime @default(now())
  device        Device   @relation(fields: [deviceId], references: [id])
}
